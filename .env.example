# Settings for `docker compose` (copy to .env — never commit .env).
# Placeholders only. Choose your own values; they stay on your computer.
# For running the server without Docker see server/.env.example.

# Password of the local PostgreSQL container (compose service `db`). Secret.
POSTGRES_PASSWORD=change-me-local-db
# Password given to every seeded synthetic account (instructor1@cpms.test, student1..3@cpms.test). Secret.
SEED_PASSWORD=change-me-local-seed

# Optional (defaults shown)
# Host port for the app: http://localhost:8080
# APP_PORT=8080
# Run the idempotent seed after migrations (set false to migrate only)
# SEED_ON_MIGRATE=true
# Login session lifetime in hours
# SESSION_TTL_HOURS=8
# Secure cookie flag: false on http://localhost, true behind https (Cloud Run)
# COOKIE_SECURE=false
# Commit label baked into the image and shown at /api/version (CI/deploy pass the real SHA)
# APP_COMMIT=local
