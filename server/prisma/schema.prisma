// Course Project Management System — baseline data model (Sprint 1)
// Change this file only through a new migration: `npm run db:dev -w server -- --name <change>`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  INSTRUCTOR
  STUDENT
}

enum ProposalStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

model User {
  id               Int          @id @default(autoincrement())
  email            String       @unique
  passwordHash     String
  displayName      String
  role             Role
  createdAt        DateTime     @default(now())
  sessions         Session[]
  memberships      TeamMember[]
  coursesTaught    Course[]     @relation("CourseInstructor")
  enrollments      Enrollment[]
  decidedProposals Proposal[]   @relation("ProposalDecider")
  auditEntries     AuditEntry[]
  submissions      Submission[]
  grades           Grade[]
}

// Server-side session: the cookie holds a random token, only its SHA-256 hash is stored.
// Logout sets revokedAt, so the token can never be reused.
model Session {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
}

model Course {
  id               Int          @id @default(autoincrement())
  code             String       @unique
  name             String
  instructorId     Int
  instructor       User         @relation("CourseInstructor", fields: [instructorId], references: [id])
  proposalDeadline DateTime
  // F-03 BR-07: team size limits (CHECK 1 <= min <= max in the migration).
  minTeamSize      Int          @default(2)
  maxTeamSize      Int          @default(3)
  teams            Team[]
  auditEntries     AuditEntry[]
  milestones       Milestone[]
  enrollments      Enrollment[]
  memberships      TeamMember[]
}

// F-03 T1: which students belong to a course (until Sprint 2 this was implied by team membership).
model Enrollment {
  courseId   Int
  userId     Int
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrolledAt DateTime @default(now())

  @@id([courseId, userId])
  @@index([userId])
}

model Team {
  id          Int          @id @default(autoincrement())
  name        String
  // F-03 T7: 8 characters from A-Z/2-9 without O, I, 0, 1, generated by the SQL function in the migration.
  joinCode    String       @unique @default(dbgenerated("cpms_join_code()"))
  createdAt   DateTime     @default(now())
  courseId    Int
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  members     TeamMember[]
  proposals   Proposal[]
  submissions Submission[]

  @@unique([courseId, name])
}

model TeamMember {
  teamId   Int
  userId   Int
  // F-03 BR-06 in the database: a student is in at most one team per course.
  courseId Int
  joinedAt DateTime @default(now())
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@unique([courseId, userId])
}

model Proposal {
  id           Int            @id @default(autoincrement())
  teamId       Int
  team         Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  title        String
  description  String
  status       ProposalStatus @default(DRAFT)
  rejectReason String?
  submittedAt  DateTime?
  decidedAt    DateTime?
  decidedById  Int?
  decidedBy    User?          @relation("ProposalDecider", fields: [decidedById], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([teamId])
}

// F-09 (FR-22): append-only audit log. Each entry is written in the same transaction as the change it
// records (L1). A trigger in the migration rejects UPDATE (L2). teamId has no FK on purpose: an entry keeps
// the id of a team that is deleted later (F-03 T6); the team name is kept in details.
enum AuditAction {
  PROPOSAL_APPROVED
  PROPOSAL_REJECTED
  TEAM_CREATED
  MEMBER_JOINED
  MEMBER_LEFT
  GRADE_RELEASED
}

model AuditEntry {
  id        Int         @id @default(autoincrement())
  courseId  Int
  course    Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  actorId   Int
  actor     User        @relation(fields: [actorId], references: [id])
  teamId    Int?
  action    AuditAction
  entityId  Int
  details   Json
  createdAt DateTime    @default(now())

  @@index([courseId, createdAt])
}

// F-04 (FR-13, BR-09): course milestones. weight is an integer percentage; the course total ≤ 100 is
// enforced in the application inside a transaction with a course row lock (a sum over rows is not a
// column constraint). The migration adds CHECK constraints for the per-row ranges.
model Milestone {
  id          Int          @id @default(autoincrement())
  courseId    Int
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String       @default("")
  dueAt       DateTime
  weight      Int
  maxScore    Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  submissions Submission[]

  @@index([courseId])
}

// F-05 (FR-15, FR-16, BR-10, BR-11): append-only versions of a team's deliverable for a milestone.
// The current version is the highest one. isLate is fixed at submission time (S2).
// ON DELETE RESTRICT on milestone: a milestone with submissions cannot be deleted (F-04 M4, S8).
model Submission {
  id            Int       @id @default(autoincrement())
  milestoneId   Int
  milestone     Milestone @relation(fields: [milestoneId], references: [id], onDelete: Restrict)
  teamId        Int
  team          Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  version       Int
  url           String
  note          String    @default("")
  isLate        Boolean
  submittedById Int
  submittedBy   User      @relation(fields: [submittedById], references: [id])
  submittedAt   DateTime  @default(now())
  grade         Grade?

  @@unique([milestoneId, teamId, version])
  @@index([teamId])
}

// F-06 (FR-17, FR-18, BR-12, D-08): one grade per submission. Only the current version is graded or released;
// a released grade is final. score ≥ 0 is a CHECK in the migration; score ≤ maxScore is checked in the service.
model Grade {
  id           Int        @id @default(autoincrement())
  submissionId Int        @unique
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  score        Int
  feedback     String
  gradedById   Int
  gradedBy     User       @relation(fields: [gradedById], references: [id])
  gradedAt     DateTime
  releasedAt   DateTime?
  updatedAt    DateTime   @updatedAt
}
