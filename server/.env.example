# Copy to server/.env (cpms_dev), server/.env.test (cpms_test) and server/.env.e2e (cpms_e2e, PORT=3100).
# Never commit the real files. Every variable the server, seed and tests read is listed here (R-02).
# Replace YOUR_PG_PASSWORD with your local PostgreSQL password.

# PostgreSQL connection string. Secret (contains the password). Required.
# Cloud Run: from Secret Manager, Unix socket form
#   postgresql://USER:PASSWORD@localhost/DB?host=/cloudsql/PROJECT:REGION:INSTANCE&schema=public
DATABASE_URL="postgresql://postgres:YOUR_PG_PASSWORD@localhost:5432/cpms_dev?schema=public"
# Port the API listens on (Cloud Run sets PORT itself; the container defaults to 8080)
PORT=3000
# Login session lifetime in hours
SESSION_TTL_HOURS=8
# Secure cookie flag: false on http://localhost, true behind https (Cloud Run)
COOKIE_SECURE=false
# Password given to every seeded synthetic account. Secret. Read only by prisma/seed.js.
SEED_PASSWORD="ChangeMe-local-only"

# Set by the container image / deploy, normally not set locally:
# NODE_ENV=development          # development | test | e2e | production (the image sets production)
# CLIENT_DIST_DIR=../client/dist # serve the built UI from the API (the image sets /app/client/dist)
# APP_COMMIT=local               # commit shown at /api/version (the build passes the Git SHA)
# SEED_ON_MIGRATE=true           # container `migrate` command: run the seed after migrations
