{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "start:e2e": "node scripts/start-e2e.js",
    "test": "vitest run",
    "db:dev": "dotenv -e .env -o -- prisma migrate dev",
    "db:deploy": "dotenv -e .env -o -- prisma migrate deploy",
    "db:seed": "dotenv -e .env -o -- prisma db seed",
    "db:generate": "prisma generate",
    "db:studio": "dotenv -e .env -o -- prisma studio"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "dotenv-cli": "^11.1.0",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1",
    "vitest": "^3.2.7"
  }
}
